# seedmix shared ESP32 configuration (board-independent settings).
#
# This file is NOT a complete configuration on its own: the target, flash size,
# panel, pins and input devices live in a per-board overlay,
# `sdkconfig.defaults.<board>`.  Both files must be combined, base first (a key
# defined in the overlay overrides the base):
#
#     SDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.defaults.ttgo_tdisplay"
#     SDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.defaults.waveshare_3_5"
#
# `scripts/build_esp32.sh` does that for you:
#
#     ./scripts/build_esp32.sh                      # ttgo_tdisplay (default)
#     BOARD=waveshare_3_5 ./scripts/build_esp32.sh  # waveshare_3_5
#
# Note that `sdkconfig.defaults` is also ESP-IDF's fallback file name, so a bare
# `idf.py build` picks up only these shared settings, which is not a usable
# configuration: the flash size then stays at ESP-IDF's 2 MB default while the
# hardened partition table needs 4 MB, so the build fails in the partition
# size check. (ESP-IDF also auto-loads `sdkconfig.defaults.<IDF_TARGET>` right after
# this file when one exists; this project deliberately uses board-named overlays
# instead, since one target can host several boards.)

# -- FreeRTOS ----------------------------------------------------------
# LVGL's recursive grid/flex layout overflows the default 3584-byte stack.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

# -- LVGL (vendored component, configured via its own Kconfig) ---------
# On ESP-IDF, LVGL is configured through Kconfig, not main/lv_conf.h.
CONFIG_LV_CONF_SKIP=y
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_BUILD_EXAMPLES=n
CONFIG_LV_BUILD_DEMOS=n
CONFIG_LV_FONT_MONTSERRAT_10=y
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_18=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_48=y

# -- seedmix: entropy / TRNG -------------------------------------------
# Hardware RNG
CONFIG_SEEDMIX_TRNG_SOURCE_HARDWARE=y

# -- hardening: no radio, no flash storage -----------------------------
# Applies to every board.

# No radio: build without the WiFi/Bluetooth/RF-PHY binary blobs, so the device
# has no radio capability and cannot transmit or receive wirelessly.  The
# compile-time #error in main_esp32.c fails the build if blobs get re-enabled.
CONFIG_APP_NO_BLOBS=y
CONFIG_BT_ENABLED=n

# No flash storage: custom partition table with ONLY the factory app (no NVS,
# no OTA, no PHY-init, no data partition), and PHY calibration storage in NVS
# disabled. The firmware must not persist secrets to flash.
CONFIG_ESP_PHY_CALIBRATION_AND_DATA_STORAGE=n
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_hardened.csv"
